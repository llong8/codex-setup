{
  "name": "haivex-codex-setup",
  "version": "0.1.0",
  "private": true,
  "description": "一键配置 Codex 使用 Haivex API 的 Electron 桌面工具",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dist:mac": "vite build && electron-builder --mac --config electron-builder.json",
